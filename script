CREATE OR REPLACE PROCEDURE practica2 AS 
       CURSOR cur1(pnombre IN VARCHAR2) IS
       SELECT nombre, ventas, titulo
       FROM empleado
       WHERE nombre like pnombre;
       cemp_rec cur1%ROWTYPE;
       vnombre VARCHAR2(30);
     BEGIN
       vnombre := 'Juan%';
       OPEN cur1(vnombre);
       DBMS_OUTPUT.PUT_LINE
         ('Ventas de empleados con nombre ' || ' ' || vnombre);
       LOOP
       FETCH cur1 INTO cemp_rec;
	EXIT WHEN cur1%NOTFOUND;
         DBMS_OUTPUT.PUT_LINE
           (cemp_rec.nombre || '  ' || cemp_rec.titulo || '  ' || cemp_rec.ventas);
       END LOOP;
     CLOSE cur1;
     END;

CREATE OR REPLACE PROCEDURE practica3(p_nom as varchar2) AS 
       CURSOR cur1(pnombre IN VARCHAR2) IS
       SELECT nombre, apellido, correo
       FROM cliente
       WHERE nombre like pnombre;
       cemp_rec cur1%ROWTYPE;
       vnombre VARCHAR2(30);
     BEGIN
       vnombre := p_nom;
       OPEN cur1(vnombre);
       DBMS_OUTPUT.PUT_LINE
         ('Ventas de empleados con nombre ' || ' ' || vnombre);
       LOOP
       FETCH cur1 INTO cemp_rec;
	EXIT WHEN cur1%NOTFOUND;
         DBMS_OUTPUT.PUT_LINE
           (cemp_rec.nombre || '  ' || cemp_rec.correo ||);
       END LOOP;
     CLOSE cur1;
     END;